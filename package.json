{
  "name": "@trysac/mcp-sqlite-readonly",
  "version": "0.0.0",
  "description": "Read-only MCP server over a SQLite file loaded into memory with sql.js: query_only pragma, single SELECT statements, bound parameters, row, cell and size caps",
  "license": "MIT",
  "author": "Miguel Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trysac/u119-mcp-sqlite-readonly.git"
  },
  "homepage": "https://github.com/Trysac/u119-mcp-sqlite-readonly#readme",
  "bugs": {
    "url": "https://github.com/Trysac/u119-mcp-sqlite-readonly/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7"
  }
}
